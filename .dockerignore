# Dependencies
node_modules/
vendor/

# Cache de bootstrap generado por el docker-compose local (packages.php,
# services.php, config.php, routes-v7.php): referencian paquetes de
# desarrollo (ej. Scribe) que --no-dev quita en la imagen de produccion.
# El entrypoint de staging ya corre config:cache/route:cache de todos modos.
bootstrap/cache/*.php

# Git
.git/
.gitignore

# Entornos
.env
.env.*
!.env.example

# Build artifacts (se generan dentro del container)
public/build/
public/hot
public/storage

# Logs y storage temporal
storage/logs/*.log
storage/framework/cache/
storage/framework/sessions/
storage/framework/views/

# Tests
tests/
coverage/

# IDE
.vscode/
.idea/
*.swp

# Docker
docker-compose.override.yml