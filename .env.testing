APP_NAME=UrbanBlade
APP_ENV=testing
APP_KEY=base64:3tmJ2lribjQ+hBlJrPj8euKIWSImIqTBRGAzXPUFz/0=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es_MX
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Mongo local (contenedor "mongo-test" en docker-compose.yml), aislado a
# proposito de la Atlas compartida con spark/ -- los tests nunca deben
# tocar barber_db. Base de datos separada ("barber_db_test") para que un
# `db.dropDatabase()` de limpieza jamas alcance datos reales.
DB_CONNECTION=mongodb
MONGODB_URI=mongodb://mongo-test:27017/?replicaSet=rs0
MONGO_DATABASE=barber_db_test

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CHATBOT_AI_PROVIDER=ollama
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=90
OLLAMA_KEEP_ALIVE=30m

SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=testing
SENTRY_TRACES_SAMPLE_RATE=0.0
