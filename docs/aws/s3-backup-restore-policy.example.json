{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListBackupPrefix",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::REEMPLAZAR_BUCKET",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "urbanblade/barber-db/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadEncryptedBackupsOnly",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::REEMPLAZAR_BUCKET/urbanblade/barber-db/*"
    }
  ]
}
