{
	# Sin TLS automático aquí: en staging/AWS, HTTPS lo termina el balanceador
	# (ALB) o se agrega despues con un dominio real. Este Caddy solo sirve
	# HTTP puro en el puerto 80 detras de esa capa.
	auto_https off
}

:80 {
	root * /var/www/html/public
	encode gzip

	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# TT10 (HT-04): HTTPS obligatorio por un año. El TLS lo termina CloudFront, que ya
		# redirige http -> https; sin "preload" porque esa lista es difícil de revertir.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# TT11 (HT-04): no anunciar software ni versión. Borrar un campo difiere la
		# operación al final de la respuesta, así que también quita lo que agrega php_fastcgi.
		-Server
		-X-Powered-By
		-Via
	}

	# TT10 (HT-04): la API solo devuelve JSON, así que su CSP no permite cargar nada.
	# El resto (Pulse del ingeniero y la documentación de Scribe) solo carga de sus CDN reales.
	@api path /api/*
	header @api Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
	@web not path /api/*
	header @web Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self'; object-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"

	# Equivalente a la regla de nginx: bloquea archivos ocultos salvo
	# /.well-known (requerido por validaciones ACME/dominio). RE2 (el motor
	# de Caddy) no soporta lookahead negativo "(?!...)" como PCRE/nginx, asi
	# que se resuelve con dos matchers combinados (AND) en vez de uno solo.
	@hidden {
		path /.*
		not path /.well-known/*
	}
	respond @hidden 404

	@sensitive {
		path_regexp sensitive \.(env|log|sql|bak|ini|ya?ml)$
	}
	respond @sensitive 404

	# php_fastcgi ya resuelve try_files/index.php/SCRIPT_FILENAME/PATH_INFO
	# por si sola -- lo que en nginx eran ~15 lineas, aqui es una sola.
	# localhost, no "app": a diferencia de docker-compose local (donde PHP-FPM
	# vive en un contenedor "app" aparte), en la imagen de staging PHP-FPM y
	# Caddy corren en el MISMO contenedor -- confirmado con un despliegue real
	# que fallaba con "lookup app: no such host" porque ese nombre de servicio
	# no existe fuera de la red de docker-compose.
	php_fastcgi localhost:9000 {
		# El default de Ollama (OLLAMA_TIMEOUT=90 en .env) necesita mas margen
		# que el timeout corto por default para el chat.
		read_timeout 120s
		write_timeout 120s
	}

	file_server
}
