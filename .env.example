APP_NAME=UrbanBlade
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Orígenes permitidos por CORS para api/* (ver config/cors.php) — el frontend
# Nuxt en ../frontend-urban corre en localhost:3000 en dev. Lista separada
# por comas; agregar el dominio real de producción cuando exista.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# A dónde redirigen las rutas web 'dashboard' y 'appointments.calendar'
# ahora que sus páginas Inertia fueron retiradas (Nuxt las reemplaza).
FRONTEND_URL=http://localhost:3000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

# Opcional: fija las passwords sembradas por los seeders de usuarios.
# Si se omiten, cada seeder genera una aleatoria y la imprime una sola vez.
# ADMIN_SEED_EMAIL=admin@urbanblade.test
# ADMIN_SEED_PASSWORD=
# RECEPTION_SEED_PASSWORD=
# BARBER_SEED_PASSWORD=
# CLIENT_SEED_PASSWORD=

# Seguridad: en local puede facilitar pruebas; en produccion deja esto en false
# y crea el administrador con AdminUserSeeder.
FIRST_USER_ADMIN_ENABLED=false

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mongodb
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_DATABASE=barber_db

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Docker incluye Mailpit para revisar correos de prueba en http://localhost:8025.
# Para envio real con Gmail SMTP, usar:
#   MAIL_MAILER=smtp
#   MAIL_SCHEME=smtp        <- IMPORTANTE: 'smtp' (STARTTLS/587) o 'smtps' (TLS/465).
#                              NO usar 'tls': Laravel 12 lo rechaza (UnsupportedSchemeException).
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=tucuenta@gmail.com
#   MAIL_PASSWORD="app-password-de-16-caracteres"
MAIL_MAILER=smtp
MAIL_SCHEME=
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@urbanblade.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Chatbot IA: proveedor del ultimo recurso (ollama local | gemini nube)
CHATBOT_AI_PROVIDER=ollama
# Ollama corre en su propio contenedor Docker (servicio 'ollama' en
# docker-compose.yml), alcanzable por su nombre de servicio en la red interna.
# Alternativa: si prefieres correr Ollama nativo en el host (para usar su GPU),
# usa OLLAMA_URL=http://host.docker.internal:11434 y arranca Ollama ahi con
# OLLAMA_HOST=0.0.0.0:11434.
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=90
OLLAMA_KEEP_ALIVE=30m
GEMINI_API_KEY=

# Push notifications (Web Push / VAPID): claves propias del proyecto, NO
# credenciales de un tercero (no hay cuenta FCM/OneSignal que crear). Generar
# un par nuevo con `php artisan tinker --execute="print_r(\Minishlink\WebPush\VAPID::createVapidKeys());"`
# y pegar aqui — nunca reusar el mismo par entre entornos.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:soporte@urbanblade.mx"

# Sentry (monitoreo de errores en produccion): vacio = SDK inactivo, no
# rompe nada. Crear proyecto tipo "Laravel" en sentry.io y pegar el DSN
# que te dan ahi (algo como https://xxx@oNNNNNN.ingest.sentry.io/NNNNNN).
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=local
# 0.0 - 1.0: fraccion de requests con tracing de performance (no solo
# errores). En local/dev, bajo o 0 para no generar ruido/costo de cuota.
SENTRY_TRACES_SAMPLE_RATE=0.0
