APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Opcional: fija las passwords sembradas por los seeders de usuarios.
# Si se omiten, cada seeder genera una aleatoria y la imprime una sola vez.
# ADMIN_SEED_EMAIL=admin@urbanblade.test
# ADMIN_SEED_PASSWORD=
# RECEPTION_SEED_PASSWORD=
# BARBER_SEED_PASSWORD=
# CLIENT_SEED_PASSWORD=

# Seguridad: en local puede facilitar pruebas; en produccion deja esto en false
# y crea el administrador con AdminUserSeeder.
FIRST_USER_ADMIN_ENABLED=false

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mongodb
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_DATABASE=barber_db

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Por defecto 'log' (los correos se escriben en storage/logs, no se envian).
# Para envio real con Gmail SMTP, usar:
#   MAIL_MAILER=smtp
#   MAIL_SCHEME=smtp        <- IMPORTANTE: 'smtp' (STARTTLS/587) o 'smtps' (TLS/465).
#                              NO usar 'tls': Laravel 12 lo rechaza (UnsupportedSchemeException).
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=tucuenta@gmail.com
#   MAIL_PASSWORD="app-password-de-16-caracteres"
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Chatbot IA: proveedor del ultimo recurso (ollama local | gemini nube)
CHATBOT_AI_PROVIDER=ollama
# Ollama corre en el host; el contenedor lo alcanza por host.docker.internal.
# El host debe arrancar Ollama con OLLAMA_HOST=0.0.0.0:11434.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=90
OLLAMA_KEEP_ALIVE=30m
GEMINI_API_KEY=
