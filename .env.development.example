# Copia este archivo como .env.development. No agregues credenciales de Atlas.
# Docker usa este archivo para interpolar la conexion local declarada en
# docker-compose.development.yml. Las demas variables siguen viniendo de .env.
APP_ENV=local
DATA_ENVIRONMENT=development
DB_CONNECTION=mongodb
MONGODB_URI=mongodb://mongo-dev:27017/?replicaSet=rsdev
MONGO_DATABASE=urbanblade_dev
ANALYTICS_MONGODB_URI=mongodb://mongo-dev:27017/?replicaSet=rsdev
ANALYTICS_MONGO_DATABASE=urbanblade_analytics_dev

# La creacion automatica del primer administrador no forma parte del arranque.
FIRST_USER_ADMIN_ENABLED=false
