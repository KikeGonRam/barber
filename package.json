{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "test:load": "k6 run k6/load-test.js",
        "test:load:realistic": "k6 run k6/realistic-test.js",
        "test:load:quick": "k6 run --duration 10s --vus 5 k6/load-test.js",
